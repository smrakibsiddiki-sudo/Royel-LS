# Store the real value as a platform Secret. Never commit a real secret.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ROYELLS_COMPUTE_HELPER_SHARED_SECRET=replace-with-a-random-48-byte-secret

# The service itself is HTTP; terminate HTTPS/mTLS in a private reverse proxy or tunnel.
ROYELLS_COMPUTE_HELPER_HOST=0.0.0.0
PORT=8080
ROYELLS_COMPUTE_HELPER_MAX_INFLIGHT=1
ROYELLS_COMPUTE_HELPER_MAX_BYTES=536870912
ROYELLS_COMPUTE_HELPER_READ_TIMEOUT_SECONDS=60
ROYELLS_COMPUTE_HELPER_TIMESTAMP_SKEW_SECONDS=300
ROYELLS_COMPUTE_HELPER_REPLAY_TTL_SECONDS=600
