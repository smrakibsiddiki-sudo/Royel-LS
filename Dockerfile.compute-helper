# Build separately from the Telegram-owning main bot:
# docker build -f Dockerfile.compute-helper -t royells-compute-helper .
FROM python:3.11-slim

WORKDIR /app

# Deliberately copy no Telegram bot code, runtime ledger, session, token, or DB.
COPY royells_compute_helper.py royells_compute_helper_service.py ./

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    ROYELLS_COMPUTE_HELPER_HOST=0.0.0.0 \
    PORT=8080 \
    ROYELLS_COMPUTE_HELPER_MAX_INFLIGHT=1 \
    ROYELLS_COMPUTE_HELPER_MAX_BYTES=536870912 \
    ROYELLS_COMPUTE_HELPER_READ_TIMEOUT_SECONDS=60 \
    ROYELLS_COMPUTE_HELPER_TIMESTAMP_SKEW_SECONDS=300 \
    ROYELLS_COMPUTE_HELPER_REPLAY_TTL_SECONDS=600

EXPOSE 8080

CMD ["python", "-m", "royells_compute_helper_service"]
